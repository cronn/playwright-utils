{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "strict": true,
    "erasableSyntaxOnly": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "lib": ["esnext", "dom"],
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "oxfmt.config.ts",
    "eslint.config.ts",
    "playwright.config.ts",
    "vitest.config.ts",
    "tsdown.config.ts",
    "./src/**/*.ts",
    "./tests/**/*.ts",
    "./docs/.vitepress/**/*.ts"
  ],
  "exclude": ["docs/.vitepress/cache", "docs/.vitepress/dist"]
}
